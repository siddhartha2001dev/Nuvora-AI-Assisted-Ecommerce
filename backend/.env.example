# Server Configuration
PORT=8000
CLIENT_URL=https://your-frontend.vercel.app

# MongoDB Database Connection URL
URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nuvora?retryWrites=true&w=majority

# JWT Authentication Secret
secretKey=your_super_secret_jwt_key_here

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Service (Brevo REST API for Render Deployment)
EMAIL=your_brevo_verified_email@gmail.com
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Google Gemini AI API Key (Product Summarizer)
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
